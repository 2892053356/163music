# ============================================
# 163Music Netlify Functions - 环境变量
# 使用方法：在 Netlify → Site configuration → Environment variables 中配置
# ============================================

# Upstash Redis REST URL（与 Render Bot 使用同一个数据库，实现 cookie 同步）
UPSTASH_REDIS_REST_URL=https://normal-sawfly-40098.upstash.io

# Upstash Redis REST Token
UPSTASH_REDIS_REST_TOKEN=AZyiAAIgcDEzM2UyZTZkM2Y2ODY0ZDY5YmM0MjFiYmUxYzEzODM0OA

# 网易云 MUSIC_U cookie（备用，Upstash 读取失败时使用）
# 注意：Bot 管理员通过 /setcookie 更新 cookie 时，会自动更新 Upstash 中的值
# Netlify Functions 会从 Upstash 读取最新的 cookie（60秒缓存）
NETEASE_
