# ============================================
# 163Music Bot - Render 部署环境变量
# 使用方法：复制以下内容，在 Render → Environment 中逐个添加
# 或者使用 Render 的 Bulk Import 功能导入
# ============================================

# Telegram Bot Token（从 @BotFather 获取）
BOT_TOKEN=你的Bot_Token

# 网易云 MUSIC_U cookie（浏览器开发者工具获取）
NETEASE_COOKIE=你的网易云Cookie

# 管理员 Telegram ID（从 @userinfobot 获取）
ADMIN_ID=你的Telegram_ID

# 音质等级：standard / higher / exhigh / lossless
MUSIC_QUALITY=standard

# 数据库类型：upstash（推荐，Render部署必须）
DB_TYPE=upstash

# Upstash Redis REST URL（从 upstash.com 获取）
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io

# Upstash Redis REST Token（从 upstash.com 获取）
UPSTASH_REDIS_REST_TOKEN=你的Upstash_Token

# 普通搜索/播放音频代理URL（Cloudflare Workers，减少Render出站流量）
# 部署 cloudflare-worker-audio-proxy.js 到 Cloudflare Workers 后填入
AUDIO_PROXY_URL=https://your-worker.workers.dev

# 内联搜索专用音频代理URL（Netlify，速度快无CPU限制，推荐）
# 部署 163music-netlify-proxy 到 Netlify 后填入
# 留空则回退使用 AUDIO_PROXY_URL
INLINE_PROXY_URL=https://your-site.netlify.app

# Render 监听端口（固定为10000，不要修改）
PORT=10000

# 内联搜索结果数量
INLINE_RESULTS_LIMIT=8

# 普通搜索结果数量
SEARCH_RESULTS_LIMIT=10
