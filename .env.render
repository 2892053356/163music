# ============================================
# 163Music Bot - Render 部署环境变量（完整版）
# 使用方法：复制以下内容，在 Render → Environment 中使用 Bulk Import 导入
# ============================================

# Telegram Bot Token（从 @BotFather 获取）
BOT_TOKEN=8998280761:AAE4m8j3ShXG2_rZzeaclPnDa2fvmcZoeEo

# 网易云 MUSIC_U cookie（浏览器开发者工具获取）
NETEASE_

# 管理员 Telegram ID（从 @userinfobot 获取）
ADMIN_ID=7420991200

# 音质等级：standard / higher / exhigh / lossless
MUSIC_QUALITY=standard

# 数据库类型：upstash（推荐，Render部署必须）
DB_TYPE=upstash

# Upstash Redis REST URL（从 upstash.com 获取）
UPSTASH_REDIS_REST_URL=https://normal-sawfly-40098.upstash.io

# Upstash Redis REST Token（从 upstash.com 获取）
UPSTASH_REDIS_REST_TOKEN=AZyiAAIgcDEzM2UyZTZkM2Y2ODY0ZDY5YmM0MjFiYmUxYzEzODM0OA

# 普通搜索/播放音频代理URL（Netlify，CF Workers IP被网易云CDN屏蔽）
AUDIO_PROXY_URL=https://mellifluous-pothos-dafce2.netlify.app

# 内联搜索专用音频代理URL（Netlify，速度快无CPU限制，推荐）
# 留空则回退使用 AUDIO_PROXY_URL
INLINE_PROXY_URL=https://mellifluous-pothos-dafce2.netlify.app

# Render 监听端口（固定为10000，不要修改）
PORT=10000

# 内联搜索结果数量
INLINE_RESULTS_LIMIT=8

# 普通搜索结果数量
SEARCH_RESULTS_LIMIT=10
